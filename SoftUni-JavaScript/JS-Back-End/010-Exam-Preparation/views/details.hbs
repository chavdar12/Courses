{{#with post}}
    <section class="details">
        <img src="{{image}}" alt="{{title}}">
        <div class="info">
            <h1>{{title}}</h1>
            <p><span>Author:</span> {{author.firstName}} {{author.lastName}}</p>
            <p><span>Keyword:</span> {{keyword}}</p>
            <p><span>Location:</span> {{location}}</p>
            <p><span>Date:</span> {{date}}</p>
            <p class="description">{{description}}</p>

            <div class="actions">
                {{#if ../isAuthor}}
                    <a class="btn" href="/posts/{{_id}}/edit">Edit</a>
                    <form action="/posts/{{_id}}/delete" method="post"><button class="btn danger">Delete</button></form>
                {{else if ../canVote}}
                    <form action="/posts/{{_id}}/vote/up" method="post"><button class="btn">UpVote +1</button></form>
                    <form action="/posts/{{_id}}/vote/down" method="post"><button class="btn danger">DownVote -1</button></form>
                {{else if ../user}}
                    <p class="thanks">Thanks For Voting</p>
                {{/if}}
            </div>

            <div class="votes">
                <p><span>Total rating of votes:</span> {{rating}}</p>
                {{#if ../voters}}
                    <p><span>People who voted for the post:</span> {{../voters}}</p>
                {{else}}
                    <p>No one has voted yet.</p>
                {{/if}}
            </div>
        </div>
    </section>
{{/with}}
