<h1>Create Accessory</h1>
<div class="form">
    <form action="/create/accessory" method="post">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" value="{{accessory.name}}">
        <label for="description">Description</label>
        <textarea id="description" name="description">{{accessory.description}}</textarea>
        <label for="imageUrl">Image URL</label>
        <input type="text" id="imageUrl" name="imageUrl" value="{{accessory.imageUrl}}">
        <input type="submit" value="Create">
    </form>
</div>
