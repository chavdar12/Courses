<section class="form-page">
    <form action="/trips/{{trip._id}}/edit" method="post">
        <h2>Edit Trip</h2>
        <label for="startPoint">Starting Point</label>
        <input type="text" id="startPoint" name="startPoint" value="{{trip.startPoint}}">
        <label for="endPoint">End Point</label>
        <input type="text" id="endPoint" name="endPoint" value="{{trip.endPoint}}">
        <label for="date">Date</label>
        <input type="date" id="date" name="date" value="{{trip.date}}">
        <label for="time">Time</label>
        <input type="time" id="time" name="time" value="{{trip.time}}">
        <label for="carImage">Car Image</label>
        <input type="text" id="carImage" name="carImage" placeholder="https://..." value="{{trip.carImage}}">
        <label for="carBrand">Car Brand</label>
        <input type="text" id="carBrand" name="carBrand" value="{{trip.carBrand}}">
        <label for="seats">Seats</label>
        <input type="number" id="seats" name="seats" min="0" max="4" value="{{trip.seats}}">
        <label for="price">Price</label>
        <input type="number" id="price" name="price" min="1" max="50" value="{{trip.price}}">
        <label for="description">Description</label>
        <textarea id="description" name="description">{{trip.description}}</textarea>
        <button class="btn" type="submit">Edit Trip</button>
    </form>
</section>
