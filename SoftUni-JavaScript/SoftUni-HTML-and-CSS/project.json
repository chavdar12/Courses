{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "SoftUni-HTML-and-CSS",
  "projectType": "application",
  "tags": ["track:SoftUni-JavaScript", "stack:node"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ../../tools/ci.sh build node",
        "cwd": "{projectRoot}"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bash ../../tools/ci.sh format prettier",
        "cwd": "{projectRoot}"
      }
    }
  }
}
