{
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "name": "cpp-advanced",
    "projectType": "application",
    "tags": ["track:SoftUni-CPP", "stack:cpp"],
    "targets": {
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bash ../../tools/ci.sh build cpp",
                "cwd": "{projectRoot}"
            }
        },
        "format": {
            "executor": "nx:run-commands",
            "options": {
                "command": "bash ../../tools/ci.sh format clang-format",
                "cwd": "{projectRoot}"
            }
        }
    }
}
