<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="NUnit" Version="4.6.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <!-- Targets .NET Framework but only drives the SikuliX java process, so it runs on .NET 10 too. -->
    <PackageReference Include="SikuliSharp" Version="1.5.0" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
    <!-- The course code uses NUnit 3 classic asserts (Assert.IsTrue, ...), which NUnit 4 moved to ClassicAssert. -->
    <Using Include="NUnit.Framework.Legacy" />
  </ItemGroup>
</Project>
