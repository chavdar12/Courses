# Copy to .env and fill in. .env is gitignored.
# Repo-level runners: https://github.com/<owner>/<repo>   Org-level: https://github.com/<org>
GITHUB_CONFIG_URL=https://github.com/chavdar12/Courses
# Fine-grained PAT. Repo: "Administration" read/write. Org: "Self-hosted runners" read/write.
GITHUB_TOKEN=github_pat_xxx
# Optional
# MIN_RUNNERS=0
# MAX_RUNNERS=3   # Docker Desktop with 3 CPUs / 4 GB fits about 3 build pods
# RUNNER_NAME=k8s-runners
