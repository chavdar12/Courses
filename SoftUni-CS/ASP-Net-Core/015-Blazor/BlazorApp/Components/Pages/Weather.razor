@page "/weather"
@inject IWeatherService WeatherService

<PageTitle>Weather</PageTitle>
<h1>Weather</h1>

@if (forecasts is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table>
        <thead><tr><th>Date</th><th>Temp. (C)</th><th>Summary</th></tr></thead>
        <tbody>
        @foreach (var f in forecasts)
        {
            <tr><td>@f.Date.ToString("yyyy-MM-dd")</td><td>@f.TemperatureC</td><td>@f.Summary</td></tr>
        }
        </tbody>
    </table>
}

@code {
    private IReadOnlyList<Forecast> forecasts;

    // Lifecycle: renders once with forecasts == null, again when the task completes.
    protected override async Task OnInitializedAsync() => forecasts = await WeatherService.GetAsync();
}
