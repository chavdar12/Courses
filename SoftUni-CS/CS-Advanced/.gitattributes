# Normalize line endings: LF in the repo, native on checkout unless pinned below.
* text=auto eol=lf

# Source
*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.sln     text eol=crlf
*.json    text
*.xml     text
*.yml     text
*.yaml    text
*.md      text diff=markdown
*.txt     text

# Binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.zip  binary
*.dll  binary
*.exe  binary
*.pdf  binary
