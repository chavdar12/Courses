@model string[]
<!DOCTYPE html>
<html lang="en">
<head><meta charset="utf-8" /><title>Comments</title></head>
<body>
<h1>Comments</h1>
<ul>
    @foreach (var comment in Model)
    {
        @* @comment is HTML-encoded; @Html.Raw(comment) would be an XSS hole. *@
        <li>@comment</li>
    }
</ul>
<form asp-action="Index" method="post">
    <label for="text">Comment</label>
    <input id="text" name="text" required />
    <button>Post</button>
</form>
</body>
</html>
