@page "/counter"
@inject IJSRuntime JS

<PageTitle>Counter</PageTitle>
<h1>Counter</h1>
<p role="status">Current count: @count</p>
<button class="increment" @onclick="Increment">Click me</button>

@code {
    private int count;

    // Component parameter set by a parent: <Counter Step="5" />.
    [Parameter]
    public int Step { get; set; } = 1;

    private async Task Increment()
    {
        count += Step;
        await JS.InvokeVoidAsync("setTitle", $"Count {count}");
    }
}
