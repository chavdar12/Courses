# Normalize line endings to LF in the repo; check out native for anything unlisted
* text=auto eol=lf

*.py    text diff=python
*.html  text diff=html
*.css   text diff=css
*.js    text
*.md    text diff=markdown
*.txt   text
*.yml   text
*.yaml  text
*.toml  text
*.cfg   text
*.json  text
*.sh    text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary

# Django generated migrations: keep out of diffs and language stats
**/migrations/0*.py  linguist-generated
